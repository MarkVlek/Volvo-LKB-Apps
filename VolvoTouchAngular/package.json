{
  "name": "volvofrontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "clean": "rimraf ./www/**",
    "start": "ng serve",
    "build": "ng build",
    "host": "ng serve --host 0.0.0.0",
    "copyToOutputDir": "cpx ./www/** ../Backend/static/VolvoFrontend/app",
    "build:prod": "set NODE_ENV=production&& npm run clean && ng build --configuration production --base-href /VolvoFrontend/app/ --deploy-url /VolvoFrontend/app/",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.1.4",
    "@angular/cdk": "^16.1.4",
    "@angular/common": "^16.1.4",
    "@angular/compiler": "^16.1.4",
    "@angular/core": "^16.1.4",
    "@angular/forms": "^16.1.4",
    "@angular/material": "^16.1.4",
    "@angular/platform-browser": "^16.1.4",
    "@angular/platform-browser-dynamic": "^16.1.4",
    "@angular/router": "^16.1.4",
    "@capacitor/device": "^6.0.2",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@types/chrome": "0.0.212",
    "angular": "^1.8.3",
    "angularx-qrcode": "^16.0.2",
    "bootstrap": "^5.3.2",
    "moment": "^2.29.4",
    "ngx-cookie-service": "^16.1.0",
    "ngx-infinite-scroll": "^16.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^8.4.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.1.4",
    "@angular/cli": "^16.1.4",
    "@angular/compiler-cli": "^16.1.4",
    "@angular/localize": "^16.2.12",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~4.9.4",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.2"
  }
}
